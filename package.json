{
  "name": "nexa-dev-bot",
  "version": "1.1.1",
  "description": "Nexa Dev Bot - Advanced Telegram DevOps & GitHub Navigator",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "npx wrangler dev",
    "lint": "eslint src test eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"*.config.js\" \"package*.json\" \"wrangler.jsonc\" \".github/workflows/*.yml\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"*.config.js\" \"package*.json\" \"wrangler.jsonc\" \".github/workflows/*.yml\" \".prettierrc.json\"",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler/build-check"
  },
  "keywords": [
    "telegram-bot",
    "github",
    "cloudflare-workers",
    "devops"
  ],
  "author": "Davood Mehraban",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "wrangler": "4.152.0"
  }
}
