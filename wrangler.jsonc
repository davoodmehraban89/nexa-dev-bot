{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-dev-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APPROVAL_REPLAY_GUARD",
        "class_name": "ApprovalReplayGuard"
      },
      {
        "name": "WORKSPACE_STORE",
        "class_name": "WorkspaceStore"
      }
    ]
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "APPROVAL_REPLAY_GUARD",
          "class_name": "ApprovalReplayGuard"
        },
        {
          "name": "WORKSPACE_STORE",
          "class_name": "WorkspaceStore"
        }
      ]
    }
  },
  "exports": {
    "ApprovalReplayGuard": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "WorkspaceStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
